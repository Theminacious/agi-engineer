# Origin of the FastAPI backend — no trailing path.
# Every caller appends the `/api` prefix itself (lib/api.ts `apiUrl` and
# `apiClient`), so including `/api` here produces requests to /api/api/... .
# Matches the value docker-compose.yml passes to the frontend service.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id_here
